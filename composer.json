{
    "name": "alexoliverwd/brace",
    "description": "A simple template language written in PHP",
    "version": "1.6.0",
    "keywords": [
        "handlebars",
        "template",
        "html"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Oliver",
            "homepage": "https://github.com/aoliverwd",
            "role": "Lead"
        }
    ],
    "support": {
        "issues": "https://github.com/aoliverwd/brace/issues",
        "source": "https://github.com/aoliverwd/brace",
        "docs": "https://github.com/aoliverwd/brace/wiki"
    },
    "prefer-stable": true,
    "require": {
        "php": ">=8.5"
    },
    "autoload": {
        "psr-4": {
            "Brace\\": "src/"
        },
        "classmap": [
            "src/"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.1",
        "laravel/pint": "^1.29",
        "rector/rector": "^2.4",
        "captainhook/captainhook-phar": "^5.29"
    },
    "scripts": {
        "test": [
            "@static",
            "@unit"
        ],
        "static": [
            "./vendor/bin/phpstan analyse -c phpstan.neon"
        ],
        "unit": [
            "./vendor/bin/phpunit -c ./tests/phpunit.xml"
        ],
        "format": [
            "./vendor/bin/pint src --preset psr12"
        ],
        "local:test": [
            "docker compose run -it php composer test"
        ],
        "local:update": [
            "docker compose run -it php composer update --optimize-autoloader"
        ],
        "local:rector": [
            "docker compose run -it php ./vendor/bin/rector"
        ]
    },
    "config": {
        "allow-plugins": {
            "captainhook/captainhook-phar": true
        }
    }
}
